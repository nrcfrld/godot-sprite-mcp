{
  "name": "godot-sprite-mcp",
  "version": "0.1.0",
  "description": "Deterministic headless MCP server that composes 2D pixel-art sprite sheets and Godot 4 SpriteFrames resources",
  "type": "module",
  "private": true,
  "module": "src/server.ts",
  "bin": {
    "godot-sprite-mcp": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts serve",
    "cli": "bun src/cli.ts",
    "generate:assets": "bun scripts/generate-assets.ts",
    "generate:building": "bun scripts/buildings/generate.ts",
    "generate:buildings": "bun scripts/buildings/batch.ts",
    "generate:village": "bun scripts/buildings/village.ts",
    "readiness": "bun scripts/readiness.ts",
    "examples": "bun scripts/examples.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
